ior) *\/\n  .fabric-quality-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 10px;\n    margin-top: 15px;\n    padding-top: 15px;\n    border-top: 1px dashed #EAEAEA;\n  }\n  .quality-item {\n    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 5px;\n  }\n  .q-icon { font-size: 16px; filter: grayscale(100%); opacity: 0.8; }\n  .q-label { font-size: 10px; font-weight: 600; text-transform: uppercase; color: #333; line-height: 1.2; }\n\n  \/* Lista de Entrega *\/\n  .v-list-entrega {\n    list-style: none;\n    padding: 0;\n    margin: 10px 0 0 0;\n  }\n  .v-list-entrega li {\n    margin-bottom: 8px;\n    display: flex;\n    gap: 8px;\n    align-items: center;\n  }\n\n  \/* Javascript Active State *\/\n  .v-acc-item.active .v-acc-icon {\n    transform: rotate(180deg);\n  }\n<\/style>\n\n<script>\n  (function(){\n    const headers = document.querySelectorAll('.v-acc-header');\n    headers.forEach(header => {\n      header.addEventListener('click', function() {\n        const item = this.parentElement;\n        const content = this.nextElementSibling;\n        \n        item.classList.toggle('active');\n\n        if (content.style.maxHeight) {\n          content.style.maxHeight = null;\n        } else {\n          content.style.maxHeight = content.scrollHeight + \"px\";\n        }\n      });\n    });\n  })();\n<\/script>"}}},"block_order":["36162ec8-4bfe-48ce-b128-dcb25f74ca10","variant_picker","kaching_bundles_app_block_yCHyeU","quantity_selector","text_TQGahM","buy_buttons","button_4ecNhJ","text_XD3Gwe","b03ccd22-2617-4a1d-ac48-e64ea4df469c","selleasy_lb_upsell_widget_bl_Uf8Qhz","liquid_8R9ern","liquid_7pzmdA","e8c7ead1-c93b-4231-9803-3f9cdc4a2e88","liquid_GP7tkE"],"custom_css":["[dir=\"ltr\"] .price-list:not(.price-list--stack) > .price:not(:last-child) {margin-right: 10px; font-weight: 100 !important;}"],"settings":{"show_progressbar":false,"show_exclusividade":false,"show_label3":false,"show_vendido