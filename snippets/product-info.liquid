    font-weight: 700;
    color: #333;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    line-height: 1.2;
    white-space: normal;
  }

  .v-coupon-action {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .v-code-box {
    border: 1px dashed #4A5D44;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    font-family: 'New York';
    font-size: 11px;
    font-weight: 700;
    color: #111;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .v-copy-btn {
    background-color: #1C2B21;
    border: none;
    border-radius: 4px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #FFFFFF;
    transition: background-color 0.2s;
    padding: 0;
  }

  .v-copy-btn:hover { background-color: #2C4233; }
  .v-copy-btn:active { transform: scale(0.95); }

  @media (max-width: 360px) {
    .v-coupon-container { padding: 8px 10px; gap: 8px; }
    .v-coupon-text { font-size: 10px; }
    .v-code-box { font-size: 10px; padding: 5px 8px; }
  }
</style>

<script>
  function copyVCoupon() {
    const textElement = document.getElementById('v-coupon-value');
    const textToCopy = textElement.innerText || textElement.textContent;

    const triggerSuccessEffect = () => {
      const btn = document.querySelector('.v-copy-btn');
      const iconCopy = document.getElementById('v-icon-copy');
      const iconCheck = document.getElementById('v-icon-check');
      
      btn.style.backgroundColor = '#4A5D44';
      iconCopy.style.display = 'none';
      iconCheck.style.display = 'block';

      setTimeout(() => {
        iconCopy.style.display = 'block';
        iconCheck.style.display = 'none';
        btn.style.backgroundColor = '#1C2B21';
      }, 2000);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(textToCopy)
        .then(triggerSuccessEffect)
        .catch(() => { fallbackCopyText(textToCopy); });
    } else {
      fallbackCopyText(textToCopy);
    }

    function fallbackCopyText(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.top = "0";
      textArea.style.left = "0";
      textArea.style.position = "fixed";
      textArea.style.opacity = "0";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();

      try {
        const successful = document.execCommand('copy');
        if(successful) { triggerSuccessEffect(); }
        else { alert('Copie o código manualmente: ' + text); }
      } catch (err) {
        console.error('Erro ao copiar', err);
        alert('Copie o código manualmente: ' + text);
      }

      document.body.removeChild(textArea);
    }
  }
</script>

