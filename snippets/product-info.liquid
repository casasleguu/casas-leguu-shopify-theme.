<style>

/* ================================

PDP: STYLE FINAL

Ajusta:

- Título maior

- Compare_at acima do preço com desconto

- Badge de desconto como tag (pill) com fonte correta

- Buy row lado a lado sem mexer na estética dos botões

================================ */



/* 1) TÍTULO MAIOR */

.product-meta h1.product-meta__title.heading.h3{

font-size: clamp(24px, 2.2vw, 36px) !important;

line-height: 1.15 !important;

}

@media (max-width: 600px){

.product-meta h1.product-meta__title.heading.h3{

font-size: clamp(20px, 5.2vw, 28px) !important;

line-height: 1.15 !important;

}

}



/* 2) PREÇO: compare_at em cima + preço com desconto embaixo */

.product-meta__price-list-container .price-list{

display:flex !important;

flex-direction:column !important;

align-items:flex-start !important;

gap:4px !important;

}

.product-meta__price-list-container .price--compare{

order:1 !important;

margin:0 !important;

}

.product-meta__price-list-container .price--highlight{

order:2 !important;

display:inline-flex !important;

align-items:center !important;

gap:10px !important;

line-height:1.1 !important;

}



/* preço do sale separado (evita "colar" na tag) */

.product-meta__price-list-container .pdp-sale-price{

display:inline-block !important;

}



/* 3) TAG DE DESCONTO: aparência e fonte correta */

.product-meta__price-list-container .pdp-off-badge{

display:inline-flex !important;

align-items:center !important;

justify-content:center !important;

padding:6px 12px !important;

border-radius:10px !important;

background:#e6e6e6 !important;

color:#111 !important;



font-family: var(--font-body-family) !important;

font-size:12px !important;

font-weight:700 !important;

line-height:1 !important;

letter-spacing:0 !important;



white-space:nowrap !important;

flex:0 0 auto !important;

}



/* evita colar por espaçamentos herdados */

.product-meta__price-list-container .price--highlight,

.product-meta__price-list-container .price--highlight *{

word-spacing: normal !important;

letter-spacing: normal !important;

}



/* 4) BUY ROW: somente layout lado a lado (sem mexer em altura/width dos botões) */

.pdp-buy-row{

display:flex !important;

align-items:stretch !important;

gap:12px !important;

}

.pdp-buy-row .pdp-qty{

flex: 0 0 140px !important;

}

.pdp-buy-row .pdp-cta{

flex: 1 1 auto !important;

}

@media (max-width: 480px){

.pdp-buy-row{ gap:10px !important; }

.pdp-buy-row .pdp-qty{ flex: 0 0 120px !important; }

}

