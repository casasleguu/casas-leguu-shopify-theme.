      width: 2600px;
      animation-name: infiniteScroll;
      animation-duration: 20s;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
    }
    .horizontal-scrolling-items__item {
      white-space: nowrap;
      text-transform: uppercase;
