  <style>
    /* Seu CSS aqui */
    @keyframes infiniteScroll {
      from {transform: translateX(0)}
      to {transform: translateX(-50%)}
    }
    .container {
      width: 100%;
      overflow-x: hidden;
    }
    .horizontal-scrolling-items {
      gap: 56px;
      display: flex;
      font-size: 25px;
