{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
    max-width: 800px;
    margin: 0 auto;
    font-family: inherit;
  }

  /* --- Caixa de Promoção Superior --- */
  .promo-box-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    text-align: center;
    padding: 30px 20px;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .promo-box-{{ section.id }} h2 {
    color: {{ section.settings.text_color }};
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 10px 0;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  .promo-box-{{ section.id }} .subtitle {
    color: {{ section.settings.text_color }};
    font-size: 13px;
    margin: 0;
    text-transform: uppercase;
  }

  /* Remove margens padrão do richtext da Shopify */
  .promo-box-{{ section.id }} .subtitle p {
    margin: 0;
  }
  .promo-box-{{ section.id }} .subtitle strong {
    font-weight: 700;
  }

  .promo-box-{{ section.id }} hr {
    border: none;
    border-top: 1px solid #dbdbdb;
    max-width: 90%;
    margin: 20px auto;
  }

  .promo-box-{{ section.id }} .disclaimer {
    color: {{ section.settings.text_color }};
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 0;
  }

  /* --- Caixa de Benefícios Inferior (Pílula) --- */
  .benefits-box-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    border-radius: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px 20px;
    gap: 20px;
  }

  .benefit-item-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.text_color }};
  }

  .benefit-item-{{ section.id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ section.settings.text_color }};
  }

  .benefit-text-{{ section.id }} {
    font-size: 14px;
    font-weight: 500;
  }

  .benefit-divider-{{ section.id }} {
    width: 1px;
    height: 24px;
    background-color: #dbdbdb;
  }

  /* --- Responsividade --- */
  @media (max-width: 480px) {
    .promo-box-{{ section.id }} h2 {
      font-size: 22px;
    }
    .promo-box-{{ section.id }} .subtitle {
      font-size: 11px;
    }
    .benefits-box-{{ section.id }} {
      flex-direction: column;
      border-radius: 12px;
      gap: 12px;
      padding: 20px;
    }
    .benefit-divider-{{ section.id }} {
      width: 100%;
      height: 1px;
    }
  }
{% endstyle %}

<section class="section-{{ section.id }}">
  
  <!-- Bloco Superior -->
  <div class="promo-box-{{ section.id }}">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}
    
    {% if section.settings.subtitle != blank %}
      <div class="subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}
    
    <hr>
    
    {% if section.settings.disclaimer != blank %}
      <p class="disclaimer">{{ section.settings.disclaimer }}</p>
    {% endif %}
  </div>

  <!-- Bloco Inferior (Benefícios) -->
  <div class="benefits-box-{{ section.id }}">
    
    <div class="benefit-item-{{ section.id }}">
      {% if section.settings.icon_1 != blank %}
        {{ section.settings.icon_1 }}
      {% endif %}
      <span class="benefit-text-{{ section.id }}">{{ section.settings.text_1 }}</span>
    </div>

    <div class="benefit-divider-{{ section.id }}"></div>

    <div class="benefit-item-{{ section.id }}">
      {% if section.settings.icon_2 != blank %}
        {{ section.settings.icon_2 }}
      {% endif %}
      <span class="benefit-text-{{ section.id }}">{{ section.settings.text_2 }}</span>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Promoção e Benefícios",
  "settings":[
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo das caixas",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Caixa Principal (Topo)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "TODAS PEÇAS POR R$99"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "<p>NA ESCOLHA DE 4 PEÇAS <strong>TODAS FICAM POR R$99 CADA</strong></p>",
      "info": "Use o botão de Negrito (B) para destacar partes do texto."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Rodapé da Promoção",
      "default": "OFERTA VÁLIDA POR TEMPO LIMITADO"
    },
    {
      "type": "header",
      "content": "Caixa de Benefícios (Embaixo)"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Texto Benefício 1",
      "default": "Frete grátis"
    },
    {
      "type": "html",
      "id": "icon_1",
      "label": "Ícone Benefício 1 (Código SVG)",
      "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle></svg>"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Texto Benefício 2",
      "default": "1ª Troca grátis"
    },
    {
      "type": "html",
      "id": "icon_2",
      "label": "Ícone Benefício 2 (Código SVG)",
      "default": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line><path d=\"M16 12.5a4.5 4.5 0 1 1-8 0\"></path><polyline points=\"6.5 11 8 12.5 9.5 11\"></polyline></svg>"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 20
    }
  ],
  "presets":[
    {
      "name": "Promoção e Benefícios"
    }
  ]
}
{% endschema %}