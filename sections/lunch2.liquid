{% assign sid = section.id %}

<section id="grid-gallery-{{ sid }}" class="grid-gallery">
  <div class="grid-gallery-wrapper" id="gallery-wrapper-{{ sid }}">
    
    {% for block in section.blocks %}
      <div class="grid-item quadrado" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: "#" }}" aria-label="{{ block.settings.alt_text | default: block.settings.image.alt | default: 'View collection' | escape }}">
          {%- assign image = block.settings.image -%}
          {% if image != blank %}
            <img
  srcset="{{ image | image_url: width: 480, height: 480, crop: 'center' }} 480w,
          {{ image | image_url: width: 720, height: 720, crop: 'center' }} 720w,
          {{ image | image_url: width: 960, height: 960, crop: 'center' }} 960w"
  src="{{ image | image_url: width: 960, height: 960, crop: 'center' }}"
  sizes="(max-width: 768px) 90vw, 33vw"
  class="lazyload"
  alt="{{ block.settings.alt_text | default: image.alt | escape | default: 'Gallery image' }}"
  loading="lazy"
  width="960"
  height="960">
          {% else %}
            <div class="grid-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </a>
      </div>
    {% endfor %}

    {% if section.blocks.size == 0 %}
      {% for i in (1..3) %}
        <div class="grid-item quadrado">
          <a href="#">
            <div class="grid-placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </a>
        </div>
      {% endfor %}
    {% endif %}

  </div>
</section>

<style>
  #grid-gallery-{{ sid }} {
    background-color: #fff;
    overflow: hidden;
    display: block;
    padding: 5px 0; /* Unifica o padding */
    margin: 0;
  }

  .grid-gallery-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: 5px;
    width: 100%;
    margin: 0 auto;
    max-width: 100%;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
    flex-shrink: 0;
  }

  .grid-item a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .grid-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s ease;
  }

  .grid-item:hover img {
    transform: scale(1.05);
  }

  .quadrado {
    aspect-ratio: 1 / 1;
  }
  
  /* Placeholder (se a imagem estiver vazia) */
  .grid-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f2f2f2;
    aspect-ratio: 1 / 1;
  }
  .grid-placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    max-width: 100px;
  }

  /* Estilo do seu código original que pode ser de outra seção, mantido por segurança */
  .retangular {
    grid-column: span 3;
    aspect-ratio: 3 / 1;
  }

  /* Mobile: vira carrossel */
  @media (max-width: 768px) {
    .grid-gallery-wrapper {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0 5px; /* Adiciona padding lateral no mobile */
      scroll-behavior: smooth; /* ADICIONADO: Faz com que a rolagem automática seja suave */
    }

    .grid-item {
      min-width: 90%; /* Um pouco menor que 100% para mostrar que há mais */
    }

    .retangular {
      display: none; /* Mantido do seu código original */
    }

    .grid-gallery-wrapper::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const wrapper = document.getElementById("gallery-wrapper-{{ sid }}");
  let autoScrollInterval;

  function startAutoScroll() {
    // Aplica apenas no Mobile (768px ou menor)
    if (window.innerWidth <= 768) {
      clearInterval(autoScrollInterval);
      
      autoScrollInterval = setInterval(() => {
        if (!wrapper) return;
        
        // Pega a largura do primeiro item para saber quanto precisa rolar
        const item = wrapper.querySelector('.grid-item');
        if (!item) return;
        
        const itemWidth = item.clientWidth;
        
        // Verifica se chegou ao fim da galeria (-10px para garantir a margem de erro na leitura do pixel)
        const maxScroll = wrapper.scrollWidth - wrapper.clientWidth;
        
        if (wrapper.scrollLeft >= maxScroll - 10) {
          // Voltar ao inicio
          wrapper.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          // Passar para o lado
          wrapper.scrollTo({ left: wrapper.scrollLeft + itemWidth, behavior: 'smooth' });
        }
      }, 5000); // 5000ms = 5 segundos
    } else {
      // Garante que no Desktop não haja scroll automático
      clearInterval(autoScrollInterval);
    }
  }

  startAutoScroll();

  // Pausa a animação se o usuário colocar o dedo na tela
  wrapper.addEventListener('touchstart', () => clearInterval(autoScrollInterval), {passive: true});
  
  // Retoma a animação 5 segundos depois do usuário soltar a tela
  wrapper.addEventListener('touchend', () => {
    setTimeout(startAutoScroll, 5000);
  }, {passive: true});

  // Atualiza ao redimensionar a tela/virar o celular
  window.addEventListener("resize", startAutoScroll);
});
</script>

{% schema %}
{
  "name": "Grid de Imagens",
  "class": "grid-gallery-section",
  "settings": [],
  "blocks":[
    {
      "type": "image",
      "name": "Imagem",
      "limit": 9,
      "settings":[
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo",
          "info": "Importante para SEO e acessibilidade."
        }
      ]
    }
  ],
  "presets":[
    {
      "name": "Grid de Imagens",
      "blocks":[
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}